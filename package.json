{
  "name": "miniclaw",
  "version": "0.4.0",
  "description": "极简 AI 助手 — Discord → Claude Code / Codex",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "register": "tsx src/commands/register.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "init": "bash init.sh",
    "cron:list": "tsx scripts/cron-list.ts",
    "cron:test": "tsx scripts/cron-test.ts",
    "stage": "tsx src/stage/index.tsx",
    "stage:repl": "tsx src/stage/repl.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.119",
    "@anthropic-ai/sdk": "^0.39.0",
    "@openai/codex-sdk": "^0.125.0",
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.5.0",
    "global-agent": "^4.1.3",
    "https-proxy-agent": "^9.0.0",
    "ink": "^7.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.1",
    "node-cron": "^4.2.1",
    "react": "^19.2.5",
    "undici": "^8.1.0",
    "uuid": "^11.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
