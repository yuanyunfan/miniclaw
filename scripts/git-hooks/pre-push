#!/usr/bin/env bash
# Pre-push gate：build + coverage ratchet + lint + cron E2E + safety/security/deps.
# Real Discord E2E stays opt-in because it needs test Discord secrets:
#   MINICLAW_RUN_DISCORD_E2E=1 git push
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "▶ pnpm run quality:push"
pnpm run quality:push

if [[ "${MINICLAW_RUN_DISCORD_E2E:-0}" == "1" ]]; then
  echo "▶ pnpm run e2e:discord"
  pnpm run e2e:discord
else
  echo "↷ Discord E2E skipped; set MINICLAW_RUN_DISCORD_E2E=1 to enable it."
fi

echo "✓ pre-push passed"
