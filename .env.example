# Secrets and process bootstrap values.
# Structured MiniClaw settings should live in ~/.miniclaw/config.yaml.

# Required
DISCORD_TOKEN=your_bot_token
MINICLAW_CONFIG=~/.miniclaw/config.yaml

# Required only when agent.provider: claude
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional for Codex when local `codex login` is not used.
# Only required for Discord voice transcription when attachments.audio_transcription.provider
# is openai, or auto chooses OpenAI. Raven/Codex proxy alone does not provide
# /audio/transcriptions; use local_faster_whisper when no OpenAI key is available.
# OPENAI_API_KEY=your_openai_api_key

# Optional provider endpoints
# ANTHROPIC_BASE_URL=http://localhost:7024
# OPENAI_BASE_URL=

# Optional proxy bootstrap. This remains env-based because it is applied before
# the YAML config loader initializes.
# MINICLAW_PROXY=http://127.0.0.1:7890

# Optional logging bootstrap
# MINICLAW_LOG_LEVEL=info
# MINICLAW_LOG_FORMAT=text

# Legacy env overrides still work and take precedence over config.yaml.
# Prefer config.yaml for readability; use env only for deployment overrides.
#
# DISCORD_CLIENT_ID=your_client_id
# DISCORD_GUILD_ID=your_guild_id
# MINICLAW_ALLOWED_USER_ID=your_discord_user_id
# MINICLAW_AGENT_PROVIDER=codex
# MINICLAW_AUTO_REPLY_CHANNELS=* # use none to require @mention outside task threads/channels
# MINICLAW_TASK_CHANNELS=
# MINICLAW_DEFAULT_CWD=~/Code
# MINICLAW_MAX_CONCURRENT_TASKS=3
# MINICLAW_DEFAULT_BUDGET_USD=1.0
# MINICLAW_DEFAULT_MAX_TURNS=30
# MINICLAW_CHAT_TIMEOUT_MS=180000
# MINICLAW_ATTACHMENT_TIMEOUT_MS=30000
# MINICLAW_REGISTER_COMMANDS_ON_START=false
# MINICLAW_CLAUDE_MODEL=claude-opus-4-7
# MINICLAW_CLAUDE_SETTING_SOURCES=user,project,local
# MINICLAW_CLAUDE_DISABLE_HOOKS=true
# MINICLAW_CODEX_MODEL=inherit
# MINICLAW_CODEX_REASONING_EFFORT=inherit
# MINICLAW_CODEX_TASK_SANDBOX=inherit
# MINICLAW_CODEX_CHAT_SANDBOX=read-only
# MINICLAW_CODEX_APPROVAL_POLICY=inherit
# MINICLAW_CODEX_WEB_SEARCH=inherit
# MINICLAW_CODEX_TIMEOUT_MS=900000
# MINICLAW_CODEX_NETWORK_ACCESS=inherit
# MINICLAW_HOOKD_ENABLED=false
# MINICLAW_HOOKD_SOCKET=~/.miniclaw/runtime/hookd.sock
# MINICLAW_HOOKD_APPROVAL_TIMEOUT_MS=600000
# MINICLAW_HOOKD_STALE_ACTIVE_MS=900000
# MINICLAW_MCP_CONFIG=~/.claude.json
# MINICLAW_MCP_ALLOWLIST=exa,context7
# MINICLAW_DB_PATH=~/.miniclaw/data.db
# MINICLAW_MAX_ATTACHMENT_MB=32
# MINICLAW_MAX_ATTACHMENTS=10
# MINICLAW_AUDIO_TRANSCRIPTION_ENABLED=true
# MINICLAW_AUDIO_TRANSCRIPTION_PROVIDER=auto
# MINICLAW_AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# MINICLAW_AUDIO_TRANSCRIPTION_LOCAL_MODEL=base
# MINICLAW_AUDIO_TRANSCRIPTION_LOCAL_PYTHON=python3
# MINICLAW_AUDIO_TRANSCRIPTION_LOCAL_DEVICE=cpu
# MINICLAW_AUDIO_TRANSCRIPTION_LOCAL_COMPUTE_TYPE=int8
# MINICLAW_AUDIO_TRANSCRIPTION_MAX_MB=25
# MINICLAW_AUDIO_TRANSCRIPTION_TIMEOUT_MS=120000
# MINICLAW_AUDIO_TRANSCRIPTION_LANGUAGE=
