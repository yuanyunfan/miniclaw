# Discord
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_client_id
DISCORD_GUILD_ID=your_guild_id

# Providers
MINICLAW_AGENT_PROVIDER=claude

# Claude provider
ANTHROPIC_API_KEY=your_api_key
MINICLAW_CLAUDE_MODEL=claude-opus-4-7
# Claude Code settings sources loaded by claude-agent-sdk.
# Use none to disable filesystem settings.
MINICLAW_CLAUDE_SETTING_SOURCES=user,project,local
# Keep local hooks/statusLine from running inside the Discord bot by default.
MINICLAW_CLAUDE_DISABLE_HOOKS=true

# Codex provider
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=
# Set any Codex option below to inherit to let Codex CLI use ~/.codex/config.toml.
MINICLAW_CODEX_MODEL=gpt-5.5
MINICLAW_CODEX_REASONING_EFFORT=medium
MINICLAW_CODEX_TASK_SANDBOX=workspace-write
MINICLAW_CODEX_CHAT_SANDBOX=read-only
MINICLAW_CODEX_APPROVAL_POLICY=never
MINICLAW_CODEX_WEB_SEARCH=live
MINICLAW_CODEX_TIMEOUT_MS=900000
MINICLAW_CODEX_NETWORK_ACCESS=true

# Claude MCP reuse for Claude provider task mode.
# Default is conservative. Use * to expose every server from ~/.claude.json.
MINICLAW_MCP_CONFIG=~/.claude.json
MINICLAW_MCP_ALLOWLIST=exa,context7

# Proxy (ClashX / VPN)
MINICLAW_PROXY=http://127.0.0.1:7890

# MiniClaw
MINICLAW_ALLOWED_USER_ID=your_discord_user_id
# Channels where plain messages become /task-style task threads without @mention.
# Comma-separated Discord channel IDs. Task channels take precedence over auto-reply channels.
MINICLAW_TASK_CHANNELS=
# Channels where plain messages become lightweight chat replies without @mention.
MINICLAW_AUTO_REPLY_CHANNELS=
MINICLAW_DEFAULT_CWD=~/Code
MINICLAW_MAX_CONCURRENT_TASKS=3
MINICLAW_DEFAULT_BUDGET_USD=1.0
MINICLAW_DEFAULT_MAX_TURNS=30
MINICLAW_DB_PATH=~/.miniclaw/data.db
MINICLAW_MAX_ATTACHMENT_MB=32
MINICLAW_MAX_ATTACHMENTS=10
